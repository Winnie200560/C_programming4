<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Point"
        MinHeight="500"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB6E6" Offset="0"/>
            <GradientStop Color="#E667AF" Offset="0.5"/> 
            <GradientStop Color="#85004B" Offset="1"/> 
        </LinearGradientBrush>
    </Window.Background>
    
    <!--автоматическое масштабирование-->
    <Viewbox Stretch="Uniform"> 
        <Grid Width="700" Height="450">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Введите координаты двух точек"
                           FontSize="24"
                           Foreground="White"
                           Margin="0,0,0,25"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,10"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Точка 1:"
                               Width="80"
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="X1"
                             Width="100"
                             Height="30"
                             Margin="5"/>

                    <TextBox x:Name="Y1"
                             Width="100"
                             Height="30"
                             Margin="5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,10"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Точка 2:"
                               Width="80"
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="X2"
                             Width="100"
                             Height="30"
                             Margin="5"/>

                    <TextBox x:Name="Y2"
                             Width="100"
                             Height="30"
                             Margin="5"/>
                </StackPanel>

                <TextBlock Text="Выберите операцию:"
                           FontSize="16"
                           Foreground="White"
                           Margin="0,20,0,10"
                           HorizontalAlignment="Center"/>

                <ComboBox x:Name="OperationBox"
                          Width="220"
                          Height="35"
                          FontSize="15"
                          HorizontalAlignment="Center">

                    <ComboBoxItem Content="X ++"/>
                    <ComboBoxItem Content="X --"/>
                    <ComboBoxItem Content="Расстояние"/>
                    <ComboBoxItem Content="X + число"/>
                    <ComboBoxItem Content="Число + X"/>
                    <ComboBoxItem Content="Целая часть от X int(x)"/>
                    <ComboBoxItem Content="Координата Y double(x)"/>

                </ComboBox>

                <TextBox x:Name="NumberBox"
                         Width="120"
                         Height="35"
                         Margin="0,15"
                         HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Расстояние"
                            Width="140"
                            Height="45"
                            Margin="10"
                            FontSize="15"
                            Background="#85004B"
                            Foreground="White"
                            BorderBrush="White"
                            Click="Distance_Click"/>

                    <Button Content="Операция"
                            Width="140"
                            Height="45"
                            Margin="10"
                            FontSize="15"
                            Background="#85004B"
                            Foreground="White"
                            BorderBrush="White"
                            Click="Operation_Click"/>

                </StackPanel>

                <TextBlock x:Name="Output"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Viewbox>
</Window>